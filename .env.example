# Neon PostgreSQL
# Pooled connection (pgbouncer) — used by the app at runtime via @prisma/adapter-neon
DATABASE_URL="postgresql://user:password@ep-example-pooler.neon.tech/falcon_unlocker?sslmode=require"
# Direct connection (no pgbouncer) — used by Prisma CLI for migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.neon.tech/falcon_unlocker?sslmode=require"

# Telegram Bot (used to verify Mini App initData)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Telegram ID that is always granted the Admin role, in addition to the
# automatic "first user" bootstrap rule from Chapter 2.
TELEGRAM_ADMIN_ID=""

# Public URL this Mini App is deployed at (used to build the web_app
# deep links attached to Telegram Bot notifications, Chapter 9).
NEXT_PUBLIC_APP_URL=""

# Shared secret Telegram sends back on every webhook call (X-Telegram-Bot-Api-
# Secret-Token header), used to verify /api/telegram/webhook requests are
# genuinely from Telegram. Generate any long random string, set it here and
# in Telegram's setWebhook call.
TELEGRAM_WEBHOOK_SECRET=""
