# Neon PostgreSQL
# Pooled connection (pgbouncer) — used by the app at runtime via @prisma/adapter-neon
DATABASE_URL="postgresql://user:password@ep-example-pooler.neon.tech/falcon_unlocker?sslmode=require"
# Direct connection (no pgbouncer) — used by Prisma CLI for migrations
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-example.neon.tech/falcon_unlocker?sslmode=require"

# Telegram Bot (used to verify Mini App initData)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Telegram ID that is always granted the Admin role, in addition to the
# automatic "first user" bootstrap rule from Chapter 2.
TELEGRAM_ADMIN_ID=""

# Public URL this Mini App is deployed at (used to build the web_app
# deep links attached to Telegram Bot notifications, Chapter 9).
NEXT_PUBLIC_APP_URL=""

# Shared secret Telegram sends back on every webhook call (X-Telegram-Bot-Api-
# Secret-Token header), used to verify /api/telegram/webhook requests are
# genuinely from Telegram. Generate any long random string, set it here and
# in Telegram's setWebhook call.
TELEGRAM_WEBHOOK_SECRET=""

# Shared secret for the unified cron endpoint (GET/POST /api/cron — Chapter
# 16's Automatic Synchronization, Chapter 18's Queue & Retry System, and any
# future scheduled task registered in src/lib/cron/registry.ts). Generate
# any long random string, set it here, and configure an external scheduler
# (e.g. cron-job.org) to call /api/cron with an
# "Authorization: Bearer <value>" header on whatever interval you like —
# each task self-gates on its own due-time logic, so frequent calls are safe.
CRON_SECRET=""

# Encryption-at-rest key for provider secrets (apiKey/apiSecret/token —
# Chapter 19, Security Center). Any string works; it's hashed (SHA-256) into
# a 256-bit AES-GCM key, so length/format don't matter. Generate any long
# random string. Changing this after providers already have encrypted
# secrets stored makes those specific secrets undecryptable — re-enter them
# (Edit provider -> fill the secret field again) after rotating this key.
ENCRYPTION_KEY=""
