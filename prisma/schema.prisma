// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
}

/// Order workflow (Chapter 11): Pending -> Checking -> Processing -> Completed / Rejected / Cancelled.
enum OrderStatus {
  PENDING
  CHECKING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id          String   @id @default(cuid())
  telegramId  BigInt   @unique
  username    String?
  firstName   String
  lastName    String?
  avatarUrl   String?
  isFirstUser Boolean  @default(false)
  role        Role     @default(CUSTOMER)
  createdAt   DateTime @default(now())

  /// Balance in USD cents. Chapter 7 (Wallet) adds recharges/transactions on top of this.
  balanceCents Int @default(0)

  /// Salted hash of the app-lock PIN (Chapter 8). Null when no PIN is set.
  pinHash          String?
  biometricEnabled Boolean @default(false)

  imeiOrders   ImeiOrder[]
  serverOrders ServerOrder[]

  rechargeOrders         RechargeOrder[]     @relation("RechargeOrderSubmitter")
  reviewedRechargeOrders RechargeOrder[]     @relation("RechargeOrderReviewer")
  walletTransactions     WalletTransaction[]
}

enum ServiceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum ServiceBadge {
  POPULAR
  NEW
  FEATURED
}

enum ServiceFieldType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
  CHECKBOX
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  imeiServices   ImeiService[]
  serverServices ServerService[]
}

model ImeiService {
  id            String        @id @default(cuid())
  name          String
  priceCents    Int
  description   String
  estimatedTime String
  status        ServiceStatus @default(ONLINE)
  badge         ServiceBadge?
  imageUrl      String?
  displayOrder  Int           @default(0)
  createdAt     DateTime      @default(now())

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  fields ImeiServiceField[]
  orders ImeiOrder[]
}

model ImeiServiceField {
  id           String           @id @default(cuid())
  label        String
  type         ServiceFieldType
  /// Comma-separated option list, only meaningful when type is SELECT.
  options      String?
  required     Boolean          @default(false)
  displayOrder Int              @default(0)

  serviceId String
  service   ImeiService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ImeiOrder {
  id          String      @id @default(cuid())
  status      OrderStatus @default(PENDING)
  /// Price snapshotted at order time, in USD cents.
  priceCents  Int
  /// Submitted values for the service's custom fields, keyed by field id.
  fieldValues Json
  tracking    String?
  notes       String?
  downloadUrl String?
  createdAt   DateTime    @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])

  serviceId String
  service   ImeiService @relation(fields: [serviceId], references: [id])

  walletTransactions WalletTransaction[]
}

enum ServerServiceType {
  LICENSE
  ACTIVATION
  CREDITS
  SUBSCRIPTION
  UNLOCK
  FRP
  FLASH
  REPAIR
}

enum ServerFieldType {
  USERNAME
  PASSWORD
  TOKEN
  IP
  SERIAL
  CUSTOM_TEXTBOX
}

model ServerService {
  id            String            @id @default(cuid())
  name          String
  priceCents    Int
  description   String
  estimatedTime String
  status        ServiceStatus     @default(ONLINE)
  badge         ServiceBadge?
  imageUrl      String?
  displayOrder  Int               @default(0)
  type          ServerServiceType
  createdAt     DateTime          @default(now())

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  fields ServerServiceField[]
  orders ServerOrder[]
}

model ServerOrder {
  id          String      @id @default(cuid())
  status      OrderStatus @default(PENDING)
  /// Price snapshotted at order time, in USD cents.
  priceCents  Int
  /// Submitted values for the service's custom fields, keyed by field id.
  fieldValues Json
  tracking    String?
  notes       String?
  downloadUrl String?
  createdAt   DateTime    @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])

  serviceId String
  service   ServerService @relation(fields: [serviceId], references: [id])

  walletTransactions WalletTransaction[]
}

model ServerServiceField {
  id           String          @id @default(cuid())
  label        String
  type         ServerFieldType
  required     Boolean         @default(false)
  displayOrder Int             @default(0)

  serviceId String
  service   ServerService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

/// Admin-configured manual payment method (Chapter 7).
model RechargeMethod {
  id             String   @id @default(cuid())
  name           String
  instructions   String
  /// Free text: crypto address, bank account, mobile money number, etc.
  accountDetails String?
  customText     String?
  imageUrl       String?
  qrCodeUrl      String?
  displayOrder   Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  rechargeOrders RechargeOrder[]
}

enum RechargeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Customer's manual recharge request: proof of payment, awaiting admin review.
model RechargeOrder {
  id          String         @id @default(cuid())
  amountCents Int
  proofUrl    String?
  proofNote   String?
  status      RechargeStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  reviewedAt  DateTime?

  userId String
  user   User @relation("RechargeOrderSubmitter", fields: [userId], references: [id])

  methodId String
  method   RechargeMethod @relation(fields: [methodId], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("RechargeOrderReviewer", fields: [reviewedById], references: [id])

  walletTransactions WalletTransaction[]
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

/// Wallet transaction history ledger (Chapter 7): every balance change.
model WalletTransaction {
  id          String                @id @default(cuid())
  type        WalletTransactionType
  amountCents Int
  reason      String
  createdAt   DateTime              @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])

  rechargeOrderId String?
  rechargeOrder   RechargeOrder? @relation(fields: [rechargeOrderId], references: [id])

  imeiOrderId String?
  imeiOrder   ImeiOrder? @relation(fields: [imeiOrderId], references: [id])

  serverOrderId String?
  serverOrder   ServerOrder? @relation(fields: [serverOrderId], references: [id])
}
