// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

/// Order workflow (Chapter 11): Pending -> Checking -> Processing -> Completed / Rejected / Cancelled.
enum OrderStatus {
  PENDING
  CHECKING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id          String   @id @default(cuid())
  telegramId  BigInt   @unique
  username    String?
  firstName   String
  lastName    String?
  avatarUrl   String?
  isFirstUser Boolean    @default(false)
  role        Role       @default(CUSTOMER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())

  /// Balance in USD cents. Chapter 7 (Wallet) adds recharges/transactions on top of this.
  balanceCents Int @default(0)

  /// Salted hash of the app-lock PIN (Chapter 8). Null when no PIN is set.
  pinHash          String?
  biometricEnabled Boolean @default(false)

  imeiOrders   ImeiOrder[]
  serverOrders ServerOrder[]

  rechargeOrders         RechargeOrder[]     @relation("RechargeOrderSubmitter")
  reviewedRechargeOrders RechargeOrder[]     @relation("RechargeOrderReviewer")
  walletTransactions     WalletTransaction[]

  supportTickets  SupportTicket[]
  supportMessages SupportMessage[]

  auditLogs              AuditLog[]
  imeiOrderStatusEvents   ImeiOrderStatusEvent[]
  serverOrderStatusEvents ServerOrderStatusEvent[]
  sentNotifications       Notification[]
}

/// Admin action log (Chapter 11).
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  createdAt DateTime @default(now())

  actorId String
  actor   User @relation(fields: [actorId], references: [id])
}

enum ServiceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum ServiceBadge {
  POPULAR
  NEW
  FEATURED
}

/// Form Generator field types (Chapter 11 extends Chapter 4's original 5).
enum ServiceFieldType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
  CHECKBOX
  DATE
  PASSWORD
  EMAIL
  IP
  IMEI
  SN
  ECID
  JSON
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())

  imeiServices   ImeiService[]
  serverServices ServerService[]
}

model ImeiService {
  id            String        @id @default(cuid())
  name          String
  priceCents    Int
  description   String
  estimatedTime String
  status        ServiceStatus @default(ONLINE)
  badge         ServiceBadge?
  imageUrl      String?
  displayOrder  Int           @default(0)
  createdAt     DateTime      @default(now())

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  fields ImeiServiceField[]
  orders ImeiOrder[]
}

model ImeiServiceField {
  id           String           @id @default(cuid())
  label        String
  type         ServiceFieldType
  /// Comma-separated option list, only meaningful when type is SELECT.
  options      String?
  /// Optional regex the submitted value must match (Chapter 11 Form Generator).
  regex        String?
  placeholder  String?
  defaultValue String?
  required     Boolean          @default(false)
  displayOrder Int              @default(0)

  serviceId String
  service   ImeiService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ImeiOrder {
  id          String      @id @default(cuid())
  status      OrderStatus @default(PENDING)
  /// Price snapshotted at order time, in USD cents.
  priceCents  Int
  /// Submitted values for the service's custom fields, keyed by field id.
  fieldValues Json
  tracking    String?
  notes       String?
  downloadUrl String?
  createdAt   DateTime    @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])

  serviceId String
  service   ImeiService @relation(fields: [serviceId], references: [id])

  walletTransactions WalletTransaction[]
  statusEvents       ImeiOrderStatusEvent[]
}

/// Order workflow history (Chapter 11): one row per status transition.
model ImeiOrderStatusEvent {
  id        String      @id @default(cuid())
  status    OrderStatus
  comment   String?
  createdAt DateTime    @default(now())

  orderId String
  order   ImeiOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  adminId String
  admin   User @relation(fields: [adminId], references: [id])
}

enum ServerServiceType {
  LICENSE
  ACTIVATION
  CREDITS
  SUBSCRIPTION
  UNLOCK
  FRP
  FLASH
  REPAIR
}

enum ServerFieldType {
  USERNAME
  PASSWORD
  TOKEN
  IP
  SERIAL
  CUSTOM_TEXTBOX
}

model ServerService {
  id            String            @id @default(cuid())
  name          String
  priceCents    Int
  description   String
  estimatedTime String
  status        ServiceStatus     @default(ONLINE)
  badge         ServiceBadge?
  imageUrl      String?
  displayOrder  Int               @default(0)
  type          ServerServiceType
  createdAt     DateTime          @default(now())

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  fields ServerServiceField[]
  orders ServerOrder[]
}

model ServerOrder {
  id          String      @id @default(cuid())
  status      OrderStatus @default(PENDING)
  /// Price snapshotted at order time, in USD cents.
  priceCents  Int
  /// Submitted values for the service's custom fields, keyed by field id.
  fieldValues Json
  tracking    String?
  notes       String?
  downloadUrl String?
  createdAt   DateTime    @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])

  serviceId String
  service   ServerService @relation(fields: [serviceId], references: [id])

  walletTransactions WalletTransaction[]
  statusEvents       ServerOrderStatusEvent[]
}

/// Order workflow history (Chapter 11): one row per status transition.
model ServerOrderStatusEvent {
  id        String      @id @default(cuid())
  status    OrderStatus
  comment   String?
  createdAt DateTime    @default(now())

  orderId String
  order   ServerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  adminId String
  admin   User @relation(fields: [adminId], references: [id])
}

model ServerServiceField {
  id           String          @id @default(cuid())
  label        String
  type         ServerFieldType
  required     Boolean         @default(false)
  displayOrder Int             @default(0)

  serviceId String
  service   ServerService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

enum RechargeContactType {
  WHATSAPP
  TELEGRAM
}

/// Admin-configured manual payment method (Chapter 7).
model RechargeMethod {
  id             String   @id @default(cuid())
  name           String
  instructions   String
  /// Free text: crypto address, bank account, mobile money number, etc.
  accountDetails String?
  customText     String?
  imageUrl       String?
  qrCodeUrl      String?
  displayOrder   Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  /// "Send proof of payment" redirects to this contact (WhatsApp phone
  /// number or Telegram username) instead of collecting proof in-app.
  contactType  RechargeContactType?
  contactValue String?

  rechargeOrders RechargeOrder[]
}

enum RechargeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Customer's manual recharge request: proof of payment, awaiting admin review.
model RechargeOrder {
  id          String         @id @default(cuid())
  amountCents Int
  proofUrl    String?
  proofNote   String?
  status      RechargeStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  reviewedAt  DateTime?

  userId String
  user   User @relation("RechargeOrderSubmitter", fields: [userId], references: [id])

  methodId String
  method   RechargeMethod @relation(fields: [methodId], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("RechargeOrderReviewer", fields: [reviewedById], references: [id])

  walletTransactions WalletTransaction[]
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

/// Wallet transaction history ledger (Chapter 7): every balance change.
model WalletTransaction {
  id          String                @id @default(cuid())
  type        WalletTransactionType
  amountCents Int
  reason      String
  createdAt   DateTime              @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])

  rechargeOrderId String?
  rechargeOrder   RechargeOrder? @relation(fields: [rechargeOrderId], references: [id])

  imeiOrderId String?
  imeiOrder   ImeiOrder? @relation(fields: [imeiOrderId], references: [id])

  serverOrderId String?
  serverOrder   ServerOrder? @relation(fields: [serverOrderId], references: [id])
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// A support "ticket" is a chat thread (Chapter 10 lists Chat and Tickets together).
model SupportTicket {
  id        String       @id @default(cuid())
  subject   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())

  userId String
  user   User @relation(fields: [userId], references: [id])

  messages SupportMessage[]
}

model SupportMessage {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User @relation(fields: [authorId], references: [id])
}

/// Admin-editable FAQ entries (Chapter 10).
model FaqItem {
  id           String   @id @default(cuid())
  question     String
  answer       String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

/// Admin-editable Help articles (Chapter 10).
model HelpArticle {
  id           String   @id @default(cuid())
  title        String
  body         String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

/// Admin-editable About content (Chapter 10). Singleton row.
model AboutPage {
  id        String   @id @default("about")
  content   String   @default("")
  updatedAt DateTime @updatedAt
}

/// News post (Chapter 11): Create/Edit/Schedule/Pin.
model NewsPost {
  id        String    @id @default(cuid())
  title     String
  body      String
  pinned    Boolean   @default(false)
  /// When set in the future, the post isn't shown until this time (Schedule).
  publishAt DateTime?
  createdAt DateTime  @default(now())
}

/// Promotional popup (Chapter 11): Color/Image/Animation/Expiration/Button+Link.
model Popup {
  id         String    @id @default(cuid())
  title      String
  message    String
  color      String?
  imageUrl   String?
  animation  String?
  buttonText String?
  buttonUrl  String?
  active     Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())
}

enum NotificationKind {
  PROMOTION
  MAINTENANCE
}

/// Broadcast notification history (Chapter 11): every push sent to all users.
model Notification {
  id             String           @id @default(cuid())
  kind           NotificationKind
  title          String?
  message        String
  recipientCount Int
  createdAt      DateTime         @default(now())

  sentById String
  sentBy   User   @relation(fields: [sentById], references: [id])
}
