// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  MODERATOR
  ADMIN
  /// Platform owner (SaaS multi-tenant foundation): sits above every tenant's
  /// own ADMIN. requireAdmin/requireStaff both accept SUPER_ADMIN too — it's
  /// a superset of tenant-admin access, not a disjoint role — so promoting a
  /// user to SUPER_ADMIN never takes away access they already had.
  SUPER_ADMIN
}

enum TenantStatus {
  ACTIVE
  SUSPENDED
}

/// SaaS subscription tiers (multi-tenant foundation, vision chapter 15).
enum SubscriptionPlan {
  STARTER
  PRO
  BUSINESS
  ENTERPRISE
}

/// A brand/tenant on the platform (multi-tenant foundation, vision chapters
/// 1-3): one row per client, each with its own Telegram bot, catalog, users,
/// wallet and API config. Falcon Unlocker itself is seeded as the first
/// tenant so existing data doesn't move — every other tenant-scoped model
/// gains its own tenantId in a later chapter; this chapter only establishes
/// the Tenant record and Super Admin role, with zero behavior change to the
/// already-running app.
model Tenant {
  id                   String           @id @default(cuid())
  name                 String
  telegramBotUsername  String?
  /// Encrypted at rest the same way Provider secrets are (Chapter 19 —
  /// src/lib/security/encryption.ts).
  telegramBotToken     String?
  ownerTelegramId      BigInt?
  email                String?
  currency             String           @default("USD")
  country              String?
  language             String           @default("en")
  logoUrl              String?
  primaryColor         String?
  secondaryColor       String?
  status               TenantStatus     @default(ACTIVE)
  subscriptionPlan     SubscriptionPlan @default(STARTER)
  subscriptionExpiresAt DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  users                  User[]
  categories             Category[]
  imeiServices           ImeiService[]
  serverServices         ServerService[]
  imeiOrders             ImeiOrder[]
  serverOrders           ServerOrder[]
  providers              Provider[]
  imeiServiceMappings    ImeiServiceMapping[]
  serverServiceMappings  ServerServiceMapping[]
  pricingSettings        PricingSettings?
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BLOCKED
}

/// Order workflow (Chapter 11): Pending -> Checking -> Processing -> Completed / Rejected / Cancelled.
enum OrderStatus {
  PENDING
  CHECKING
  PROCESSING
  COMPLETED
  REJECTED
  CANCELLED
}

model User {
  id          String     @id @default(cuid())
  telegramId  BigInt     @unique
  username    String?
  firstName   String
  lastName    String?
  avatarUrl   String?
  isFirstUser Boolean    @default(false)
  role        Role       @default(CUSTOMER)
  status      UserStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())

  /// Balance in USD cents. Chapter 7 (Wallet) adds recharges/transactions on top of this.
  balanceCents Int @default(0)

  /// Salted hash of the app-lock PIN (Chapter 8). Null when no PIN is set.
  pinHash          String?
  biometricEnabled Boolean @default(false)

  imeiOrders   ImeiOrder[]
  serverOrders ServerOrder[]

  rechargeOrders         RechargeOrder[]     @relation("RechargeOrderSubmitter")
  reviewedRechargeOrders RechargeOrder[]     @relation("RechargeOrderReviewer")
  walletTransactions     WalletTransaction[]

  supportTickets  SupportTicket[]
  supportMessages SupportMessage[]

  auditLogs               AuditLog[]
  imeiOrderStatusEvents   ImeiOrderStatusEvent[]
  serverOrderStatusEvents ServerOrderStatusEvent[]
  sentNotifications       Notification[]

  /// Multi-tenant foundation: which brand this account belongs to. Nullable
  /// for now — every existing user is backfilled to the seeded Falcon
  /// Unlocker tenant by this chapter's migration, but query-level tenant
  /// scoping (every admin-*.ts action filtering by tenantId) is a later
  /// chapter, so this isn't enforced as required yet.
  tenantId String?
  tenant   Tenant? @relation(fields: [tenantId], references: [id])
}

/// Admin action log (Chapter 11).
model AuditLog {
  id        String   @id @default(cuid())
  action    String
  details   String?
  createdAt DateTime @default(now())

  actorId String
  actor   User   @relation(fields: [actorId], references: [id])
}

enum ServiceStatus {
  ONLINE
  OFFLINE
  MAINTENANCE
}

enum ServiceBadge {
  POPULAR
  NEW
  FEATURED
}

/// Form Generator field types (Chapter 11 extends Chapter 4's original 5;
/// UDID/MEID/ICCID added for field format validation).
enum ServiceFieldType {
  TEXT
  TEXTAREA
  NUMBER
  SELECT
  CHECKBOX
  DATE
  PASSWORD
  EMAIL
  IP
  IMEI
  SN
  ECID
  UDID
  MEID
  ICCID
  JSON
}

model Category {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  /// Tenant isolation (Chapter 25): category names are unique per tenant,
  /// not globally — two brands can both have an "Unlock" category.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  imeiServices   ImeiService[]
  serverServices ServerService[]

  @@unique([tenantId, name])
}

model ImeiService {
  id            String        @id @default(cuid())
  name          String
  priceCents    Int
  description   String
  estimatedTime String
  status        ServiceStatus @default(ONLINE)
  badge         ServiceBadge?
  imageUrl      String?
  displayOrder  Int           @default(0)
  createdAt     DateTime      @default(now())

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  /// Tenant isolation (Chapter 25): which brand owns this catalog entry.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  /// Smart Routing (Chapter 15): how to pick among this service's enabled
  /// provider mappings. See RoutingStrategy for the meaning of each value.
  routingStrategy RoutingStrategy @default(PREFERRED)

  fields   ImeiServiceField[]
  orders   ImeiOrder[]
  mappings ImeiServiceMapping[]
}

model ImeiServiceField {
  id           String           @id @default(cuid())
  label        String
  type         ServiceFieldType
  /// Comma-separated option list, only meaningful when type is SELECT.
  options      String?
  /// Optional regex the submitted value must match (Chapter 11 Form Generator).
  regex        String?
  placeholder  String?
  defaultValue String?
  required     Boolean          @default(false)
  displayOrder Int              @default(0)
  /// Field format validation: overrides the type's built-in default length
  /// (e.g. a service-specific SN length), unset falls back to the default
  /// in src/lib/validation/field-formats.ts.
  minLength    Int?
  maxLength    Int?

  serviceId String
  service   ImeiService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

model ImeiOrder {
  id          String      @id @default(cuid())
  status      OrderStatus @default(PENDING)
  /// Price snapshotted at order time, in USD cents.
  priceCents  Int
  /// Submitted values for the service's custom fields, keyed by field id.
  fieldValues Json
  tracking    String?
  notes       String?
  downloadUrl String?
  createdAt   DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  serviceId String
  service   ImeiService @relation(fields: [serviceId], references: [id])

  /// Tenant isolation (Chapter 26): snapshotted from the ordered service's
  /// own tenant at order-creation time, same spirit as priceCents.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  walletTransactions WalletTransaction[]
  statusEvents       ImeiOrderStatusEvent[]
}

/// Order workflow history (Chapter 11): one row per status transition.
model ImeiOrderStatusEvent {
  id        String      @id @default(cuid())
  status    OrderStatus
  comment   String?
  createdAt DateTime    @default(now())

  orderId String
  order   ImeiOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Null for system-triggered transitions (Chapter 18's Queue & Retry System
  /// advancing an order after a successful automatic provider submission) —
  /// every other transition is an admin action and always sets this.
  adminId String?
  admin   User?   @relation(fields: [adminId], references: [id])
}

enum ServerServiceType {
  LICENSE
  ACTIVATION
  CREDITS
  SUBSCRIPTION
  UNLOCK
  FRP
  FLASH
  REPAIR
}

enum ServerFieldType {
  USERNAME
  PASSWORD
  TOKEN
  IP
  SERIAL
  CUSTOM_TEXTBOX
}

model ServerService {
  id            String            @id @default(cuid())
  name          String
  priceCents    Int
  description   String
  estimatedTime String
  status        ServiceStatus     @default(ONLINE)
  badge         ServiceBadge?
  imageUrl      String?
  displayOrder  Int               @default(0)
  type          ServerServiceType
  createdAt     DateTime          @default(now())

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  /// Tenant isolation (Chapter 25): which brand owns this catalog entry.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  /// Smart Routing (Chapter 15): how to pick among this service's enabled
  /// provider mappings. See RoutingStrategy for the meaning of each value.
  routingStrategy RoutingStrategy @default(PREFERRED)

  fields   ServerServiceField[]
  orders   ServerOrder[]
  mappings ServerServiceMapping[]
}

model ServerOrder {
  id          String      @id @default(cuid())
  status      OrderStatus @default(PENDING)
  /// Price snapshotted at order time, in USD cents.
  priceCents  Int
  /// Submitted values for the service's custom fields, keyed by field id.
  fieldValues Json
  tracking    String?
  notes       String?
  downloadUrl String?
  createdAt   DateTime    @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  serviceId String
  service   ServerService @relation(fields: [serviceId], references: [id])

  /// Tenant isolation (Chapter 26): snapshotted from the ordered service's
  /// own tenant at order-creation time, same spirit as priceCents.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  walletTransactions WalletTransaction[]
  statusEvents       ServerOrderStatusEvent[]
}

/// Order workflow history (Chapter 11): one row per status transition.
model ServerOrderStatusEvent {
  id        String      @id @default(cuid())
  status    OrderStatus
  comment   String?
  createdAt DateTime    @default(now())

  orderId String
  order   ServerOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Null for system-triggered transitions (Chapter 18's Queue & Retry System
  /// advancing an order after a successful automatic provider submission) —
  /// every other transition is an admin action and always sets this.
  adminId String?
  admin   User?   @relation(fields: [adminId], references: [id])
}

model ServerServiceField {
  id           String          @id @default(cuid())
  label        String
  type         ServerFieldType
  required     Boolean         @default(false)
  displayOrder Int             @default(0)
  placeholder  String?
  /// Field format validation: overrides the type's built-in default length,
  /// unset falls back to the default in src/lib/validation/field-formats.ts.
  minLength    Int?
  maxLength    Int?

  serviceId String
  service   ServerService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
}

enum RechargeContactType {
  WHATSAPP
  TELEGRAM
}

/// Admin-configured manual payment method (Chapter 7).
model RechargeMethod {
  id             String   @id @default(cuid())
  name           String
  instructions   String
  /// Free text: crypto address, bank account, mobile money number, etc.
  accountDetails String?
  customText     String?
  imageUrl       String?
  qrCodeUrl      String?
  displayOrder   Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  /// "Send proof of payment" redirects to this contact (WhatsApp phone
  /// number or Telegram username) instead of collecting proof in-app.
  contactType  RechargeContactType?
  contactValue String?

  rechargeOrders RechargeOrder[]
}

enum RechargeStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Customer's manual recharge request: proof of payment, awaiting admin review.
model RechargeOrder {
  id          String         @id @default(cuid())
  amountCents Int
  proofUrl    String?
  proofNote   String?
  status      RechargeStatus @default(PENDING)
  createdAt   DateTime       @default(now())
  reviewedAt  DateTime?

  userId String
  user   User   @relation("RechargeOrderSubmitter", fields: [userId], references: [id])

  methodId String
  method   RechargeMethod @relation(fields: [methodId], references: [id])

  reviewedById String?
  reviewedBy   User?   @relation("RechargeOrderReviewer", fields: [reviewedById], references: [id])

  walletTransactions WalletTransaction[]
}

enum WalletTransactionType {
  CREDIT
  DEBIT
}

/// Wallet transaction history ledger (Chapter 7): every balance change.
model WalletTransaction {
  id          String                @id @default(cuid())
  type        WalletTransactionType
  amountCents Int
  reason      String
  createdAt   DateTime              @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  rechargeOrderId String?
  rechargeOrder   RechargeOrder? @relation(fields: [rechargeOrderId], references: [id])

  imeiOrderId String?
  imeiOrder   ImeiOrder? @relation(fields: [imeiOrderId], references: [id])

  serverOrderId String?
  serverOrder   ServerOrder? @relation(fields: [serverOrderId], references: [id])
}

enum TicketStatus {
  OPEN
  ANSWERED
  CLOSED
}

/// A support "ticket" is a chat thread (Chapter 10 lists Chat and Tickets together).
model SupportTicket {
  id        String       @id @default(cuid())
  subject   String
  status    TicketStatus @default(OPEN)
  createdAt DateTime     @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id])

  messages SupportMessage[]
}

model SupportMessage {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])
}

/// Admin-editable FAQ entries (Chapter 10).
model FaqItem {
  id           String   @id @default(cuid())
  question     String
  answer       String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

/// Admin-editable Help articles (Chapter 10).
model HelpArticle {
  id           String   @id @default(cuid())
  title        String
  body         String
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
}

/// Admin-editable About content (Chapter 10). Singleton row.
model AboutPage {
  id        String   @id @default("about")
  content   String   @default("")
  updatedAt DateTime @updatedAt
}

/// News post (Chapter 11): Create/Edit/Schedule/Pin.
model NewsPost {
  id        String    @id @default(cuid())
  title     String
  body      String
  pinned    Boolean   @default(false)
  /// When set in the future, the post isn't shown until this time (Schedule).
  publishAt DateTime?
  createdAt DateTime  @default(now())
}

/// Promotional popup (Chapter 11): Color/Image/Animation/Expiration/Button+Link.
model Popup {
  id         String    @id @default(cuid())
  title      String
  message    String
  color      String?
  imageUrl   String?
  animation  String?
  buttonText String?
  buttonUrl  String?
  active     Boolean   @default(true)
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  /// Optional Telegram channel (@username or numeric chat id, bot must be a
  /// member) — when set, this popup is skipped for users who already belong
  /// to that channel instead of nagging them to join again.
  requiredChannel String?
}

enum NotificationKind {
  PROMOTION
  MAINTENANCE
}

/// Broadcast notification history (Chapter 11): every push sent to all users.
model Notification {
  id             String           @id @default(cuid())
  kind           NotificationKind
  title          String?
  message        String
  recipientCount Int
  createdAt      DateTime         @default(now())

  sentById String
  sentBy   User   @relation(fields: [sentById], references: [id])
}

enum ProviderType {
  DHRU_FUSION
  PHP_API
  REST_API
  JSON_API
  XML_API
  CUSTOM_API
  WEBX
  GSM_THEME
}

/// Smart Routing Engine (Chapter 15) strategies for picking a provider among
/// a service's enabled mappings.
/// - CHEAPEST: lowest cached providerPriceCents first.
/// - FASTEST: lowest average response time, from recent ProviderConnectionLog.
/// - HIGHEST_SUCCESS_RATE: highest success rate, from recent ProviderConnectionLog.
/// - PREFERRED: mapping.priority order (the admin's explicit ranking).
/// - MANUAL: only the top-priority mapping is used; no automatic fallback.
enum RoutingStrategy {
  CHEAPEST
  FASTEST
  HIGHEST_SUCCESS_RATE
  PREFERRED
  MANUAL
}

/// Automatic Synchronization (Chapter 16): how often a provider's catalog,
/// prices, and balance are refreshed without an admin manually clicking Sync.
enum SyncFrequency {
  MANUAL
  HOURLY
  EVERY_6_HOURS
  DAILY
}

/// Provider Gateway (Chapter 12): a single external unlocking/GSM API, isolated
/// behind the connector interface built in Chapter 13. The core app never
/// contains provider-specific logic — only this generic record + connector.
model Provider {
  id       String       @id @default(cuid())
  name     String
  type     ProviderType
  baseUrl  String
  username String?

  /// Credentials are never sent to the frontend in full (only masked) — see
  /// admin-providers.ts. Encrypted at rest (Chapter 19 — src/lib/security/
  /// encryption.ts); values written before Chapter 19 that are still
  /// plaintext keep working (decryptSecret passes them through unchanged)
  /// until next rotated.
  apiKey           String?
  apiSecret        String?
  token            String?
  /// Secret Rotation Support (Chapter 19): set whenever apiKey/apiSecret/
  /// token is actually changed. Null means never rotated since creation.
  secretsRotatedAt DateTime?

  timeoutMs          Int     @default(30000)
  priority           Int     @default(0)
  enabled            Boolean @default(true)
  /// Rate Limiting (Chapter 19): max outbound calls to this provider per
  /// minute, enforced in base-connector.ts. Null means unlimited.
  rateLimitPerMinute Int?

  /// Automatic Synchronization (Chapter 16): MANUAL means only "Sync Now" runs it.
  syncFrequency    SyncFrequency @default(MANUAL)
  lastSyncAt       DateTime?
  lastBalanceCents Int?
  lastBalanceAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Tenant isolation (Chapter 28): which brand owns this provider — never
  /// shared, since it holds that brand's own API credentials and credit.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  connectionLogs   ProviderConnectionLog[]
  apiLogs          ApiLog[]
  imeiMappings     ImeiServiceMapping[]
  serverMappings   ServerServiceMapping[]
  queueEntries     OrderQueueEntry[]
  queueAttemptLogs QueueAttemptLog[]
}

/// Connection history (Chapter 12): one row per "Test API connection" call.
model ProviderConnectionLog {
  id             String   @id @default(cuid())
  success        Boolean
  responseTimeMs Int?
  statusCode     Int?
  errorMessage   String?
  createdAt      DateTime @default(now())

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

/// API Logs (Chapter 17): every outbound HTTP call any connector makes,
/// captured once at the shared fetchWithTimeout chokepoint (base-connector.ts)
/// so every provider type is logged identically without provider-specific code.
model ApiLog {
  id             String   @id @default(cuid())
  /// Which ProviderConnector method this call was made from (e.g.
  /// "getBalance", "submitOrder") — lets "Retry Request" safely re-invoke
  /// the same operation instead of raw-replaying stored bytes, which would
  /// require storing credentials alongside the log.
  operation      String
  endpoint       String
  method         String
  requestBody    String?
  responseBody   String?
  statusCode     Int?
  responseTimeMs Int
  success        Boolean
  errorMessage   String?
  createdAt      DateTime @default(now())

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@index([providerId, createdAt])
}

/// Service Mapping (Chapter 14): links a Falcon IMEI service to one or more
/// provider services. Multiple providers per Falcon service, priority-ordered
/// (Chapter 15's routing engine picks among enabled mappings by priority).
model ImeiServiceMapping {
  id                    String   @id @default(cuid())
  providerServiceId     String
  /// Cached label from the provider's service list, refreshed on sync (Chapter 16).
  providerServiceName   String?
  /// Cached price from the provider's service list, in USD cents. Powers the
  /// CHEAPEST routing strategy (Chapter 15); refreshed on sync (Chapter 16).
  providerPriceCents    Int?
  /// Cached estimated turnaround and category label from the provider's
  /// service list, refreshed on sync (Chapter 16).
  providerEstimatedTime String?
  providerCategory      String?
  priority              Int      @default(0)
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now())

  /// Margin (Chapter 23): overrides PricingSettings' default for this
  /// mapping specifically. Null falls back to the default. Only ever used
  /// to compute a *suggested* selling price shown to the admin — never
  /// applied to ImeiService.priceCents on its own.
  marginPercent Int?
  marginCents   Int?

  imeiServiceId String
  imeiService   ImeiService @relation(fields: [imeiServiceId], references: [id], onDelete: Cascade)

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  /// Tenant isolation (Chapter 28): must match both imeiService.tenantId and
  /// provider.tenantId — enforced at creation, since this join table is
  /// exactly what could otherwise let one brand route orders through
  /// another brand's paid provider credentials.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([imeiServiceId, providerId, providerServiceId])
}

/// Service Mapping (Chapter 14): the Server-service equivalent of ImeiServiceMapping.
model ServerServiceMapping {
  id                    String   @id @default(cuid())
  providerServiceId     String
  providerServiceName   String?
  /// Cached price from the provider's service list, in USD cents. Powers the
  /// CHEAPEST routing strategy (Chapter 15); refreshed on sync (Chapter 16).
  providerPriceCents    Int?
  /// Cached estimated turnaround and category label from the provider's
  /// service list, refreshed on sync (Chapter 16).
  providerEstimatedTime String?
  providerCategory      String?
  priority              Int      @default(0)
  enabled               Boolean  @default(true)
  createdAt             DateTime @default(now())

  /// Margin (Chapter 23): overrides PricingSettings' default for this
  /// mapping specifically. Null falls back to the default. Only ever used
  /// to compute a *suggested* selling price shown to the admin — never
  /// applied to ServerService.priceCents on its own.
  marginPercent Int?
  marginCents   Int?

  serverServiceId String
  serverService   ServerService @relation(fields: [serverServiceId], references: [id], onDelete: Cascade)

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  /// Tenant isolation (Chapter 28): must match both serverService.tenantId
  /// and provider.tenantId — enforced at creation, since this join table is
  /// exactly what could otherwise let one brand route orders through
  /// another brand's paid provider credentials.
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  @@unique([serverServiceId, providerId, providerServiceId])
}

/// Queue & Retry System (Chapter 18) lifecycle for one queue entry.
enum QueueStatus {
  QUEUED
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Queue & Retry System (Chapter 18): Order -> Queue -> Provider -> Response.
/// Created once per order at order-creation time (only when the ordered
/// service has at least one enabled provider mapping), then walked by the
/// process-queue cron task (via the unified /api/cron endpoint) or a manual
/// "Process Queue Now", trying each candidate from the Chapter 15 routing
/// plan in order and retrying automatically on failure until maxRetries or
/// the candidate list (per triedProviderIds) is exhausted.
model OrderQueueEntry {
  id      String @id @default(cuid())
  /// "IMEI" | "SERVER" — matches the OrderKind/MappingKind convention used
  /// elsewhere (admin-orders.ts, admin-service-mappings.ts) rather than a
  /// redundant Prisma enum. No FK to ImeiOrder/ServerOrder for the same
  /// reason those actions already join by kind + id instead of a relation.
  kind    String
  orderId String

  status            QueueStatus @default(QUEUED)
  attempts          Int         @default(0)
  maxRetries        Int
  retryDelaySeconds Int
  nextAttemptAt     DateTime    @default(now())
  /// Provider ids already tried in the current retry cycle — reset to empty
  /// by a manual retry so a fresh pass can try every mapped provider again.
  triedProviderIds  String[]    @default([])
  lastError         String?
  providerOrderId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  currentProviderId String?
  currentProvider   Provider? @relation(fields: [currentProviderId], references: [id])

  attemptLogs QueueAttemptLog[]

  /// Prevents duplicate submissions at the source: an order can only ever
  /// have one queue entry, no matter how many times enqueueing is attempted.
  @@unique([kind, orderId])
  @@index([status, nextAttemptAt])
}

/// One row per provider submission attempt for a queue entry — the visible retry history.
model QueueAttemptLog {
  id           String   @id @default(cuid())
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())

  queueEntryId String
  queueEntry   OrderQueueEntry @relation(fields: [queueEntryId], references: [id], onDelete: Cascade)

  providerId String
  provider   Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)
}

/// Global retry defaults (Chapter 18), admin-configurable. Single row, id
/// fixed to "singleton" — Timeout is already configured per-provider
/// (Provider.timeoutMs, Chapter 12), so it isn't duplicated here.
model QueueSettings {
  id                String   @id @default("singleton")
  maxRetries        Int      @default(3)
  retryDelaySeconds Int      @default(60)
  updatedAt         DateTime @updatedAt
}

/// Margin (Chapter 22): default markup applied on top of a provider's cost
/// price when suggesting a selling price for a service mapping. Both are
/// optional and stack (percent applied first, then the flat amount added) —
/// null means "no default markup of that kind". A mapping's own
/// marginPercent/marginCents (Chapter 23) overrides these per-mapping.
/// Tenant isolation (Chapter 28): one row per tenant instead of a single
/// platform-wide singleton — tenantId itself is the primary key, since a
/// tenant has at most one of these.
model PricingSettings {
  tenantId             String   @id
  tenant               Tenant   @relation(fields: [tenantId], references: [id])
  defaultMarginPercent Int?
  defaultMarginCents   Int?
  updatedAt            DateTime @updatedAt
}

/// Unified Cron System: one row per task run, written by every task
/// registered in src/lib/cron/registry.ts regardless of outcome — the
/// execution audit trail for whatever scheduler (cron-job.org) calls
/// /api/cron.
model CronRunLog {
  id         String   @id @default(cuid())
  task       String
  startedAt  DateTime
  finishedAt DateTime
  durationMs Int
  success    Boolean
  detail     String?
  error      String?
  createdAt  DateTime @default(now())

  @@index([task, createdAt])
}

/// Security Center (Chapter 19), admin-configurable. Single row.
model SecuritySettings {
  id String @id @default("singleton")

  /// IP Restrictions (future-ready): comma/newline-separated IPs or address
  /// prefixes allowed to use admin/staff actions. Empty/null = disabled (no
  /// restriction) — this is the safe default so an admin can't lock
  /// themselves out by leaving it unset. Enforced in requireAdmin/
  /// requireStaff the moment it's filled in, not just a decorative toggle.
  adminIpAllowlist String?

  updatedAt DateTime @updatedAt
}
